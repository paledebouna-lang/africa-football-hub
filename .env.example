# Supabase — Database (Project Settings > Database > Connection string)
# Pooled connection, used by the app at runtime (port 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used by Prisma for migrations (port 5432)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase — Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service role key (Project Settings > API > service_role) — server-only, never
# exposed to the browser. Lets the admin panel upload images without a member
# account, by bypassing storage RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Public site URL (used for auth redirects and SEO metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Password protecting the /admin panel
ADMIN_PASSWORD="<choose-a-strong-password>"

# SMTP — sends organisation-review notification emails (separate from Supabase
# Auth's own SMTP settings, configured in the Supabase dashboard)
SMTP_HOST="<mail.yourdomain.org>"
SMTP_PORT="465"
SMTP_USER="<noreply@yourdomain.org>"
SMTP_PASSWORD="<smtp-password>"
# Where "new organisation request" notifications are sent. Defaults to SMTP_USER.
ADMIN_NOTIFICATION_EMAIL="<noreply@yourdomain.org>"
